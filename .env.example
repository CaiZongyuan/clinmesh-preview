# ClinMesh Preview / Connected Clinic example secrets & runtime configuration.
# Copy local Worker secrets into `.dev.vars` (gitignored); never commit real credentials.

# --- Core LLM & Voice (Phase 1 & Connected Clinic) ---
LLM_API_KEY=your-openai-compatible-api-key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.3-flash
# LLM_REASONING_EFFORT=low
# BAILIAN_TOKEN=your-bailian-dashscope-token

# --- Connected Clinic Workspace & Auth (S1) ---
# Set CLINIC_MODE=connected to isolate into the connected-clinic DO namespace and enforce staff/patient auth on all routes.
CLINIC_MODE=connected
# CLINIC_WORKSPACE_NAME=connected-clinic

# Production WeChat MiniProgram code2Session credentials (required for real devices):
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=your-wechat-app-secret

# Local/dev-only switches (MUST remain unset or false in public deployments):
# WECHAT_AUTH_MODE=scripted
# DEMO_RESET_ENABLED=true

# --- WuKongIM Local Container (S0 / infrastructure/wukongim/docker-compose.yml) ---
WUKONGIM_MANAGER_TOKEN=replace-with-strong-internal-manager-token
WUKONGIM_HTTP_PORT=15001
WUKONGIM_WS_PORT=15200
