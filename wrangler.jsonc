{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinmesh-preview",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLINIC_WORKSPACE", "class_name": "ClinicWorkspaceDO" },
      { "name": "SIMULATED_PATIENT", "class_name": "SimulatedPatientDO" },
      { "name": "CLINICAL_COPILOT", "class_name": "ClinicalCopilotDO" },
      { "name": "CONSULTATION_VOICE", "class_name": "ConsultationVoiceAgent" },
      { "name": "PATIENT_SERVICE_AGENT", "class_name": "PatientServiceAgentDO" },
      { "name": "FOLLOWUP_AGENT", "class_name": "FollowUpAgentDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClinicWorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SimulatedPatientDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ClinicalCopilotDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ConsultationVoiceAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["PatientServiceAgentDO"] },
    { "tag": "v6", "new_sqlite_classes": ["FollowUpAgentDO"] }
  ],
  // LLM_API_KEY and BAILIAN_TOKEN are secrets: put them in .dev.vars locally (see README), never here.
  "vars": {
    "LLM_PROVIDER": "openai-compatible",
    "LLM_BASE_URL": "https://open.bigmodel.cn/api/paas/v4",
    "LLM_MODEL": "glm-5.3-flash",
    "LLM_REASONING_EFFORT": "low",
    "LLM_EFFORT_STYLE": "zhipu",
    // What the Clinical Copilot's model chip offers (comma-separated); unverified without a key, like the URL above.
    "LLM_MODEL_OPTIONS": "glm-5.3-flash,glm-5.3",
    // A step that streams nothing for this long fails as stalled, even if the provider ignores the abort.
    "AGENT_STALL_TIMEOUT_MS": "60000",
    "PATIENT_TURN_TIMEOUT_MS": "30000",
    "PATIENT_TURN_EXPIRY_GRACE_MS": "5000"
  }
}
