page {
  background-color: #f3f4f7;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-pad {
  padding: 24rpx;
}

.demo-banner {
  background: #e9f0fc;
  color: #175fb8;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.btn-primary {
  background: #1764c0;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 24rpx;
  text-align: center;
}

.btn-secondary {
  background: #ebeef2;
  color: #0f172a;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 14rpx 20rpx;
  text-align: center;
}

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e9f0fc;
  color: #175fb8;
  font-size: 22rpx;
}

.error-box {
  background: #fef2f2;
  color: #b4232c;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.input-box {
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
