<view class="page-pad">
  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <button class="btn-primary" bindtap="goBook" style="margin-bottom: 20rpx;">新建门诊预约</button>
  <view wx:if="{{appointments.length === 0}}" class="card muted">暂无门诊预约</view>
  <view wx:for="{{appointments}}" wx:key="appointmentId" class="card">
    <view class="row">
      <view class="card-title" style="margin-bottom: 0;">{{item.doctorName}} · {{item.departmentName}}</view>
      <view class="badge">{{item.status}}</view>
    </view>
    <view class="muted" style="margin-top: 8rpx;">时段：{{item.startsAt}}</view>
    <view wx:if="{{item.status === 'booked' || item.status === 'checked_in'}}" style="margin-top: 14rpx;">
      <view class="btn-secondary" data-id="{{item.appointmentId}}" bindtap="onCancel">取消预约</view>
    </view>
  </view>
</view>
