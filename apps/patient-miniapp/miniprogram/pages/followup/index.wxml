<view class="page-pad">
  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{plans.length === 0}}" class="card muted">暂无随访计划</view>
  <view wx:for="{{plans}}" wx:key="planId" class="card" data-id="{{item.planId}}" bindtap="openPlan">
    <view class="row">
      <view class="card-title" style="margin-bottom: 0;">{{item.title}}</view>
      <view class="badge">{{item.status}}</view>
    </view>
    <view class="muted" style="margin-top: 8rpx;">主诊医生：{{item.ownerStaffName}}</view>
  </view>
</view>
